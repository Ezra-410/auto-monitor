# --- Bases de données ---
PG_USER=monitor
PG_PASSWORD=change_me
MYSQL_USER=monitor
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too

# --- Sécurité ---
# Token partagé des routes /internal/** (long, aléatoire)
INTERNAL_API_TOKEN=generer_une_longue_valeur_aleatoire
# Clé RSA privée PEM encodée en base64 (scripts/gen-jwt-key.sh)
JWT_PRIVATE_KEY=
# Clé de chiffrement AES-256 des tokens Git en base (openssl rand -base64 32)
ENCRYPTION_KEY=
# Compte administrateur seedé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# --- LLM (agent-worker) ---
# Ordre de priorité des fournisseurs (Mistral d'abord, fallback OpenAI)
LLM_PROVIDER_ORDER=mistral,openai
# Mettre LLM_PROVIDER=mock pour un dev sans aucune clé
LLM_PROVIDER=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_DAILY_TOKEN_BUDGET=2000000
HEARTBEAT_MINUTES=5

# --- URLs publiques ---
PUBLIC_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:4000
